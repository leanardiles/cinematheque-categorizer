# Supabase Database
DATABASE_URL=op://Cinematheque Categorizer/Supabase/pooler_url

# TMDB API
TMDB_READ_TOKEN=op://Cinematheque Categorizer/TMDB/read_access_token

SYNC_SECRET=op://Cinematheque Categorizer/Sync Secret/password

# Encrypts each user's Stremio auth key in the database
ENCRYPTION_KEY=op://Cinematheque Categorizer/Encryption Key/password

# Single-user values from before accounts existed. Only read once by
# python -m app.accounts import-env, which moves them into the first user's
# account; safe to remove afterwards.
ADDON_TOKEN=op://Cinematheque Categorizer/Addon Token/password
API_TOKEN=op://Cinematheque Categorizer/API Token/password
STREMIO_AUTH_KEY=op://Cinematheque Categorizer/Stremio Auth Key/auth_key
